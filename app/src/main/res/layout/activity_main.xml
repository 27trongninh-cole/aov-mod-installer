<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/logo_header"
                android:scaleType="centerCrop"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mod Ninstaller"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#e94560" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Liên Quân Mobile - by Ninfinity"
                    android:textSize="12sp"
                    android:textColor="#666666" />
            </LinearLayout>

            <!-- Shizuku badge -->
            <LinearLayout
                android:id="@+id/shizuku_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_shizuku_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="16sp"
                    android:textColor="#888888"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_shizuku_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shizuku"
                    android:textSize="11sp"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- Info card — CỐ ĐỊNH, không nằm trong khu vực bị ẩn/hiện khi vuốt
             chuyển đổi công cụ, vì phiên bản game/trạng thái Resources cần luôn
             hiển thị bất kể đang ở khu Cài Mod hay khu Công cụ khác. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THÔNG TIN"
                android:textSize="11sp"
                android:textColor="#555555"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <!-- Game version row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phiên bản game"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_game_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang tải..."
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Resources status row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Trạng thái Resources"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_resources_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa kiểm tra"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Khu vực công cụ cài mod cốt lõi (Fix/Cài/Xóa Mod) — ẩn hiện bằng
             animation vuốt lên/xuống với khu "Công cụ khác" bên dưới. -->
        <LinearLayout
            android:id="@+id/layout_core_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_fix_resources"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#e94560"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btn_fix_resources"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="🔧"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fix Resources"
                            android:textColor="#ffffff"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tải và cài Resources từ server"
                            android:textColor="#ffcccc"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_info_fix"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:text="ⓘ"
                    android:textSize="18sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:alpha="0.7" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Install Mod button -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_install_mod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#0f3460"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btn_install_mod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="📦"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cài file Mod"
                            android:textColor="#ffffff"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chọn file .zip mod để cài"
                            android:textColor="#aaaacc"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_info_mod"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:text="ⓘ"
                    android:textSize="18sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:alpha="0.7" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Remove Mod button -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_remove_mod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#2a2a3e"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btn_remove_mod"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:text="🗑️"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xóa tất cả Mod"
                            android:textColor="#ffffff"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khôi phục Resources gốc"
                            android:textColor="#888888"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_info_remove"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:text="ⓘ"
                    android:textSize="18sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:alpha="0.7" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_created_mods"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#2a2a3e"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/btn_created_mods"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="📦"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Các Mod đã tạo"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem, cài lại, hoặc xoá mod đã tải"
                        android:textColor="#888888"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        </LinearLayout>
        <!-- Hết layout_core_tools -->

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="#e94560"
            android:layout_marginBottom="16dp" />

        <!-- Thanh gạch ngang kiểu "home indicator" iOS — vuốt lên để chuyển
             sang khu "Công cụ khác", vuốt xuống để quay lại. Có thể bấm (tap)
             làm phương án dự phòng cho người không quen thao tác vuốt. -->
        <LinearLayout
            android:id="@+id/handle_bar_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="40dp"
                android:layout_height="5dp"
                android:background="@drawable/drag_handle_pill"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_handle_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧰 Các công cụ khác"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Khu vực "Công cụ khác" — ẨN theo mặc định, thay thế layout_core_tools
             khi người dùng vuốt/bấm thanh gạch ngang phía trên. -->
        <LinearLayout
            android:id="@+id/layout_other_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- Mod Tools Section -->
        <TextView
            android:id="@+id/tv_tool_section_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CÔNG CỤ TẠO MOD"
            android:textSize="11sp"
            android:textColor="#555555"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp" />

        <!-- Các thẻ công cụ được TẠO TỰ ĐỘNG từ danh sách OTHER_TOOLS trong
             MainActivity.java — không cần thêm/sửa gì ở file XML này nữa. Muốn
             thêm tool mới, chỉ cần sửa danh sách đó (xem hướng dẫn ngay phía
             trên khai báo OTHER_TOOLS trong MainActivity.java). -->
        <LinearLayout
            android:id="@+id/container_other_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        </LinearLayout>
        <!-- Hết layout_other_tools -->

        <!-- Credit -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ⓒ Ninfinity | Infinite Creativity. All rights reserved."
            android:textSize="11sp"
            android:textColor="#333355"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>

    <!-- Nút hướng dẫn (product tour / spotlight) — cố định góc dưới trái,
         không cuộn theo nội dung vì nằm ngoài ScrollView, trong FrameLayout gốc -->
    <TextView
        android:id="@+id/btn_help_tour"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:text="?"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:background="@drawable/circle_help_button"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:elevation="4dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Overlay loading khi khởi động app — che toàn bộ UI trong lúc app chạy
         chuỗi kiểm tra đầu tiên (Shizuku sẵn sàng → tải config → check bảo
         trì/version, kể cả các lần thử lại nếu Shizuku "ngủ gật"). Tự ẩn khi
         xong, hoặc tự ẩn sau timeout an toàn nếu có gì bất thường kéo dài quá
         lâu — không để người dùng bị kẹt màn hình loading vĩnh viễn.
         Đặt SAU CÙNG trong FrameLayout để luôn nằm trên cùng, che hết mọi thứ
         phía dưới; clickable=true để chặn luôn thao tác chạm xuyên qua trong
         lúc đang loading. -->
    <LinearLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1a1a2e"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#e94560"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang kiểm tra kết nối..."
            android:textColor="#888899"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
